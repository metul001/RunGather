{
  "name": "bangladesh-event-platform",
  "version": "0.3.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:database": "node --import tsx tests/database.ts",
    "check": "npm run typecheck && npm test && npm run test:database"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.95.3",
    "expo": "58.0.25",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "supabase": "^3.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  },
  "type": "module",
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.1"
    }
  }
}
