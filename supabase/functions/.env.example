# Edge Function secrets ONLY. Never copy these into EXPO_PUBLIC variables.
PUSH_DISPATCH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Optional: required only if Expo push access-token security is enabled.
EXPO_ACCESS_TOKEN=
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are supplied by
# the Supabase function runtime. Keep service-role credentials server-side.
